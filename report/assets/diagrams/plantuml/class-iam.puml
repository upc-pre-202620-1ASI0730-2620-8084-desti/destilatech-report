@startuml
title Diagrama de clases — IAM (Identity & Access Management)
skinparam dpi 180
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #4a3b34
skinparam ArrowThickness 1.2
skinparam roundCorner 0
skinparam class {
  BackgroundColor #F7EEE1
  BorderColor #A0522D
  FontColor #2b211c
  AttributeFontColor #2b211c
  HeaderBackgroundColor #EBD9BF
}
skinparam entity {
  BackgroundColor #F7EEE1
  BorderColor #A0522D
  FontColor #2b211c
}
skinparam stereotypeCBackgroundColor #D99B3C
skinparam stereotypeIBackgroundColor #8FA6B8
skinparam stereotypeEBackgroundColor #B5A17C
hide empty members
skinparam classAttributeIconSize 0
left to right direction

class Account {
  -id : Guid
  -fullName : string
  -businessName : string
  -email : string
  -passwordHash : string
  -businessType : BusinessType
  -isActive : bool
  -createdAt : DateTime
  +Register(fullName, businessName, email, password, businessType) : Account
  +Authenticate(password) : bool
  +ChangePassword(newPassword) : void
  +UpdateBusinessProfile(businessName) : void
  #ValidateEmailUniqueness() : bool
  -HashPassword(password) : string
}
class TrialPeriod {
  -id : Guid
  -accountId : Guid
  -startDate : DateTime
  -endDate : DateTime
  -status : TrialStatus
  +Start(accountId) : TrialPeriod
  +DaysRemaining(today) : int
  +IsExpiringSoon(today) : bool
  +Expire() : void
}
class PasswordRecoveryToken {
  -id : Guid
  -accountId : Guid
  -tokenHash : string
  -expiresAt : DateTime
  -used : bool
  +Issue(accountId) : PasswordRecoveryToken
  +IsValid(now) : bool
  +MarkUsed() : void
}
class AccessToken <<valueobject>> {
  -value : string
  -expiresAt : DateTime
  +IsExpired(now) : bool
}
class AuthenticationService <<service>> {
  -accounts : IAccountRepository
  -tokens : ITokenProvider
  +Register(request) : Account
  +Login(email, password) : AccessToken
  +Logout(token) : void
  +RequestPasswordRecovery(email) : void
  +ResetPassword(token, newPassword) : void
}
interface IAccountRepository {
  +FindByEmail(email) : Account
  +FindById(id) : Account
  +Save(account) : void
}
interface ITokenProvider {
  +Issue(account) : AccessToken
  +Revoke(token) : void
}
enum BusinessType {
  PRODUCER
  RETAILER
}
enum TrialStatus {
  ACTIVE
  EXPIRED
}

Account "1" --> "1" TrialPeriod : tiene
Account "1" --> "0..*" PasswordRecoveryToken : solicita
Account ..> BusinessType : clasificada como
TrialPeriod ..> TrialStatus : estado
AuthenticationService ..> IAccountRepository : consulta
AuthenticationService ..> ITokenProvider : emite tokens con
AuthenticationService ..> AccessToken : devuelve
AuthenticationService ..> Account : autentica
@enduml
