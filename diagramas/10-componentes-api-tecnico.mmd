flowchart LR
  http["HTTP Endpoints & Middleware<br/>Componente: ASP.NET Core<br/>Token, business_id, DTO y OpenAPI"]:::component
  app["Application Services<br/>Componente: C#<br/>Casos de uso y transacción local"]:::component
  domain["Domain Model<br/>Componente: C# puro<br/>Agregados, invariantes y eventos"]:::component
  ports["Repositories & Unit of Work<br/>Componente: EF Core<br/>Mapeo y persistencia por contexto"]:::component
  payment["Payment Gateway Adapter<br/>Componente: C# / HTTPS<br/>Checkout, webhook y verificación"]:::component
  db["MySQL<br/>Contenedor externo al foco<br/>Tablas por contexto"]:::external
http -->|"invoca caso de uso"| app
app -->|"ejecuta reglas"| domain
app -->|"usa interfaces"| ports
app -->|"usa IPaymentGateway"| payment
ports -->|"SQL parametrizado"| db
