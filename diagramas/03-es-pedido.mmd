flowchart LR
  user["Productor / Comercializador<br/>Actor<br/>Selecciona cliente y productos"]:::actor
  cmd["ConfirmSalesOrder<br/>Comando<br/>SalesOrder valida líneas positivas"]:::command
  stock["StockItem<br/>Agregado<br/>Disponibilidad por negocio/producto"]:::aggregate
  event["OrderConfirmed + StockChanged<br/>Eventos<br/>Pedido y salidas en misma transacción"]:::event
  policy["EvaluateLowStock<br/>Política<br/>Saldo menor o igual al umbral"]:::policy
  query["Stock / Alerts / OrderHistory<br/>Modelos de lectura<br/>Inventario actualizado y avisos"]:::query
user -->|"confirma"| cmd
cmd -->|"solicita salida"| stock
stock -->|"si hay stock"| event
event -->|"evalúa saldo"| policy
policy -->|"actualiza vistas"| query
